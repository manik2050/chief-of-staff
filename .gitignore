# Cursor MCP config with local credential paths — keep the .example, never the filled file
.cursor/mcp.json

# Never commit credentials. The real protection is not putting them here at all.
*.pem
*.key
*.p12
.env
.env.*
credentials.json
client_secret*.json
token.json
*token*.json
gcp-*.json
service-account*.json

# Generated by the installer / path contract
paths.json

# Agent output — these belong in the install root, not in the repo
briefings/
drafts/
my-tasks-archive.yaml
work-log/*.md
!work-log/README.md
!work-log/_template.md

# Test scratch
tests/.tmp/
.tmp/

__pycache__/
*.py[cod]

.DS_Store
*.swp
