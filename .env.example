# Optional API key for /generate. Leave empty to run locally without auth.
CHIEF_OF_STAFF_API_KEY=

# prompt | heuristic | adapter
CHIEF_OF_STAFF_GENERATOR=heuristic

# Used when CHIEF_OF_STAFF_GENERATOR=prompt (OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Used when CHIEF_OF_STAFF_GENERATOR=adapter
CHIEF_OF_STAFF_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
CHIEF_OF_STAFF_ADAPTER_DIR=artifacts/adapters/v1
